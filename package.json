{
  "name": "hongguo-downloader",
  "version": "3.0.0",
  "description": "红果短剧播放与下载",
  "main": "main-android.js",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:react && electron-builder --win --x64 --publish never",
    "build:zip": "npm run build:react && electron-builder --win --x64 --publish never --dir && node scripts/make-zip.js",
    "build:dir": "npm run build:react && electron-builder --win --x64 --publish never --dir",
    "build:portable": "npm run build:react && electron-builder --win portable --x64 --publish never",
    "build:installer": "npm run build:react && electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --dir",
    "zip": "node scripts/make-zip.js",
    "setup:ffmpeg:mac": "node scripts/setup-ffmpeg-mac.js",
    "build:mac": "node scripts/setup-ffmpeg-mac.js arm64 x64 && npm run build:react && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "build:mac:dir": "node scripts/setup-ffmpeg-mac.js arm64 x64 && npm run build:react && electron-builder --mac --arm64 --x64 --dir --publish never",
    "test": "node scripts/test.cjs",
    "build:android:ui": "node scripts/build-android-mac-source.mjs && vite build --config vite.android.config.mjs",
    "build:android": "bash scripts/build-android.sh",
    "build:android:tv:release-compatible": "bash scripts/build-android.sh --tv-release-compatible",
    "build:android:tv:release": "bash scripts/build-android.sh --tv-release",
    "build:android:phone:release-compatible": "bash scripts/build-android.sh --phone-release-compatible",
    "build:android:phone:release": "bash scripts/build-android.sh --phone-release",
    "check:android": "node --experimental-test-coverage --test scripts/check-android-source.test.mjs && node scripts/check-android-project.cjs",
    "check:android:device": "node scripts/check-android-device.mjs",
    "check:android:playback": "node scripts/check-android-playback.mjs",
    "check:android:playback:ui": "bash scripts/check-android-playback-ui.sh",
    "check:android:playback:device": "node scripts/check-android-playback-device.mjs",
    "check:android:mobile": "node scripts/check-android-mobile-update.mjs"
  },
  "dependencies": {
    "anime4k-webgpu": "1.0.0",
    "axios": "1.20.0",
    "buffer": "6.0.3",
    "core-js": "3.51.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.21.5",
    "js-yaml": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.7.4",
    "vite": "^5.4.11",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "joi": "17.13.8",
    "source-map-js": "1.2.2"
  },
  "build": {
    "appId": "io.github.jackotom.hongguo-drama-mac",
    "productName": "红果短剧",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main-android.js",
      "preload-android.js",
      "desktop-android-player/**/*",
      "dist-react-android/**/*",
      "src/android/**/*",
      "src/native/**/*",
      "src/store.js"
    ],
    "asar": true,
    "artifactName": "hongguo-downloader-3.0-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe",
            "WINDOWS-*.txt",
            "COPYING.*",
            "LICENSE.md"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-2.3-便携版.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "红果短剧下载器",
      "artifactName": "hongguo-downloader-2.3-win-x64-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "build/ffmpeg/darwin-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "COPYING.*",
            "LICENSE.md",
            "MACOS-*.txt"
          ]
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        },
        {
          "from": "build/app-update.yml",
          "to": "app-update.yml"
        }
      ],
      "binaries": [
        "Contents/Resources/bin/ffmpeg",
        "Contents/Resources/bin/ffprobe"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Video",
      "icon": "build/icon.png",
      "maintainer": "skydeadpeng",
      "extraResources": [
        {
          "from": "build/ffmpeg/linux-x64",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "build/ffmpeg",
          "to": "bin",
          "filter": [
            "FFMPEG-NOTICE.txt",
            "COPYING.GPLv3",
            "LICENSE.md"
          ]
        },
        {
          "from": "LICENSE",
          "to": "LICENSE.txt"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE.txt"
        },
        {
          "from": "THIRD-PARTY-NOTICES.md",
          "to": "THIRD-PARTY-NOTICES.md"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "skydeadpeng",
      "repo": "hongguo-android-cast"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
