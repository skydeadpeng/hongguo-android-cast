<?xml version="1.0" encoding="utf-8"?>
<!-- Keep clean-checkout debug builds reproducible and use the same system trust
     anchors as release builds; private diagnostic certificates are not required. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
