<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only overlay: additionally trust the local mitmproxy CA (see
     res/xml/network_security_config.xml in this source set) for protocol
     diagnostics. The release merge keeps the manifest without this attribute. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
